# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo .env NUNCA deve ser enviado para o GitHub (já está no .gitignore).

# ── IA ──────────────────────────────────────────────────────
# Obrigatória: usada nos resumos e nas perguntas sobre o documento
ANTHROPIC_API_KEY=sua_chave_aqui
# Opcional: perguntas gerais vão para o Gemini. Sem ela, tudo usa o Claude.
GOOGLE_API_KEY=sua_chave_aqui

# ── Banco de dados (opcional) ───────────────────────────────
# Sem PostgreSQL o app funciona normalmente, só não salva o histórico.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docmind
DB_USER=postgres
DB_PASSWORD=sua_senha
